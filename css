    border-radius: 2px 8px 8px 2px; /* Spine on left, rounded on right */
    box-shadow: 
        15px 20px 50px -10px rgba(0,0,0,0.8), 
        inset 1px 1px 0 rgba(255,255,255,0.1);
    border: 1px solid #2a2a2a;
    transform: perspective(1000px) rotateY(-5deg); /* Slight 3D turn */
    transition: transform 0.4s ease;
}
.poster-frame:hover {
    transform: perspective(1000px) rotateY(0deg) scale(1.02);
}

/* Rating Badge under poster */
.poster-rating-badge {
    background: #161412;
    border: 1px solid #333;
    border-radius: 8px;
    box-shadow: inset 0 2px 5px rgba(0,0,0,0.5);
}
.pr-label { color: #666; font-family: 'JetBrains Mono'; letter-spacing: 2px; }
.pr-val, .sp-val, .lan-val { text-shadow: none; font-family: 'Playfair Display', serif; }
.pr-val { color: var(--gold); }

/* 3. Center Column: Book Details */
.movie-title {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    color: #e8e4dc;
    text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
    letter-spacing: 0.5px;
    margin-bottom: 20px;
}

/* Tags & Genres */
.hero-tag {
    background: #2a2724;
    border: 1px solid #3e3a35;
    color: #999;
    font-family: 'Crimson Text', serif;
    font-style: italic;
    font-size: 0.9rem;
    text-transform: capitalize; /* "History" instead of "HISTORY" */
    padding: 4px 12px;
}

/* Info Grid (Pages, Year) */
.ii-label { color: var(--accent); opacity: 0.8; font-family: 'JetBrains Mono'; }
.ii-val { font-family: 'Crimson Text', serif; font-size: 1.2rem; color: #ccc; }

/* The Plot / Description */
.movie-plot {
    font-family: 'Crimson Text', serif;
    font-size: 0.9rem;
    color: #dcd6ce; /* Off-white for readability */
    opacity: 0.9;
}

/* Tropes Section */
.section-title { color: #555; padding-bottom: 5px; display: inline-block; font-family: 'JetBrains Mono', serif; }
.chip {
    background: transparent;
    border: 1px solid #444;
    color: #888;
    font-family: 'JetBrains Mono';
    font-size: 0.65rem;
}

/* 4. Navigation Buttons (Close / Back) */
.nav-btn {
    background: #161412;
    border: 1px solid #333;
    color: #777;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}
.nav-btn:hover {
    background: #2a2724;
    color: #fff;
    border-color: #555;
}
.nav-btn.back-btn { border-radius: 8px; font-family: 'JetBrains Mono'; text-transform: uppercase; letter-spacing: 1px; }

/* 5. Mobile Adjustments for Vintage Theme */
@media (max-width: 900px) {
    .eth-modal-panel.movie-mode { background: #1e1b19 !important; }
    .movie-title { font-size: 2.2rem; }
    .poster-frame { transform: none; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
}

/* ================================================== */
/* --- VINTAGE SERIES MODAL (THE LEDGER) --- */
/* ================================================== */

/* 1. The Container */
.collection-layout {
    background: var(--bg-root); /* Match the dark paper texture */
}

/* 2. The Sidebar (Leather/Wood Panel) */
.cl-sidebar {
    background: #1e1b19 !important; /* Dark leather tone */
    border-right: 1px solid #3e3a35;
    box-shadow: 
        inset -10px 0 20px -10px rgba(0,0,0,0.8), /* Shadow on right side */
        5px 0 15px rgba(0,0,0,0.5); /* Drop shadow onto list */
    z-index: 20;
}

/* Sidebar Typography */
.cl-title {
    font-family: 'Playfair Display', serif;
    color: #e8e4dc;
    text-shadow: 0 2px 5px rgba(0,0,0,0.5);
    font-size: 2rem;
    letter-spacing: 0;
}
.cl-stat-box {
    background: #161412;
    border: 1px solid #333;
    box-shadow: inset 0 2px 5px rgba(0,0,0,0.3);
}
.cl-stat-val { font-family: 'Crimson Text', serif; font-size: 1.1rem; color: var(--accent); }
.cl-stat-label { font-family: 'JetBrains Mono'; letter-spacing: 1px; color: #666; }

/* Sidebar Poster */
.cl-poster-card {
    border-radius: 2px 8px 8px 2px;
    box-shadow: 
        10px 10px 30px rgba(0,0,0,0.6), 
        inset 1px 1px 0 rgba(255,255,255,0.1);
    border: 1px solid #2a2a2a;
    transform: rotateY(-5deg); /* Subtle 3D turn */
}

/* 3. The Sticky Header (Top of the List) */
.cl-header-sticky {
    background: rgba(26, 24, 22, 0.95) !important; /* Dark background */
    border-bottom: 1px solid #3e3a35;
    backdrop-filter: blur(10px);
}
.cl-h-title {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    color: #888;
    text-transform: none; /* "Books in series" instead of UPPERCASE */
    font-size: 1rem;
}
.cl-h-count {
    background: #3e3025; /* Dark brown badge */
    color: var(--gold);
    border: 1px solid #554a3f;
    font-family: 'Crimson Text', serif;
}

/* 4. The List Items (Ledger Rows) */
.collection-row {
    background: #1e1b19; /* Dark card background */
    border: 1px solid #33302b;
    border-radius: 4px; /* Sharper corners */
    margin-bottom: 10px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    transition: all 0.2s ease;
}

.collection-row:hover {
    background: #262320; /* Slightly lighter on hover */
    border-color: var(--accent);
    transform: translateX(4px); /* Slide right instead of scaling */
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
}

/* Row Typography */
.cr-index {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    color: #555;
    font-size: 1.2rem;
}
.collection-row:hover .cr-index { color: var(--gold); }

.cr-title {
    font-family: 'Crimson Text', serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: #dcd6ce;
    letter-spacing: 0;
}
.cr-year {
    font-family: 'JetBrains Mono';
    font-size: 0.75rem;
    color: var(--accent);
    opacity: 0.7;
}

.cr-plot {
    font-family: 'Crimson Text', serif;
    color: #8c867a;
    font-style: italic;
}

/* Row Poster (Small thumbnail) */
.cr-poster {
    border-radius: 2px;
    border: 1px solid #333;
    filter: sepia(30%); /* Slight vintage filter */
}
.collection-row:hover .cr-poster { filter: sepia(0%); }

/* 5. Status Icons & Buttons */
.cr-status-icon {
    border: 1px solid #444;
    color: #555;
}
.cr-status-icon.is-watched {
    background: rgba(85, 124, 85, 0.1); /* Muted green bg */
    border-color: #557c55;
    color: #557c55;
}
.pill {
    font-family: 'JetBrains Mono';
    border-radius: 2px; /* Square tags */
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* 6. Scrollbar Fix for the List */
.cl-scroll-area::-webkit-scrollbar { width: 8px; }
.cl-scroll-area::-webkit-scrollbar-track { background: #1a1816; }
.cl-scroll-area::-webkit-scrollbar-thumb { background: #3e3a35; border: 1px solid #1a1816; }

/* Force Title Case for Genres on Grid Cards */
.eth-card-meta .sub {
    text-transform: capitalize !important;
}
.st-meta {
    text-transform: capitalize !important;
}

/* In Progress Bookmark Container */
.eth-bookmark {
    position: absolute;
    top: -4px;
    left: 12px;
    z-index: 20;
    width: 0;
    height: 0;
    
    /* Drop shadow for the whole bookmark against the book cover */
    filter: drop-shadow(2px 4px 4px rgba(0,0,0,0.8));
}

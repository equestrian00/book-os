.eth-timeline-stream::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: linear-gradient(to bottom, transparent, var(--accent) 20%, var(--accent) 80%, transparent); opacity: 0.3; }
.stream-group { padding-bottom: 40px; }
.stream-header { font-size: 1.1rem; font-weight: 800; color: white; margin-left: -41px; margin-bottom: 15px; display: flex; align-items: center; gap: 15px; text-transform: uppercase; letter-spacing: 1px; }
.sh-dot { width: 16px; height: 16px; background: #000; border: 3px solid var(--accent); border-radius: 50%; box-shadow: 0 0 10px var(--accent-glow); position: relative; z-index: 2; }
.stream-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 15px; }
.stream-card { display: flex; align-items: center; gap: 14px; padding: 12px; border-radius: 14px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); cursor: pointer; transition: 0.2s ease; position: relative; overflow: hidden; }
.stream-card:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.1); transform: translateX(5px); }
.st-poster { width: 45px; height: 68px; border-radius: 6px; background-size: cover; background-position: center; position: relative; box-shadow: 0 4px 10px rgba(0,0,0,0.5); }
.st-date-badge { position: absolute; top: -4px; left: -4px; background: #222; border: 1px solid #333; color: white; padding: 2px 5px; border-radius: 5px; text-align: center; font-size: 0.65rem; font-weight: 700; }
.st-info { display: flex; flex-direction: column; gap: 3px; }
.st-title { font-weight: 700; color: #eee; font-size: 0.9rem; }
.st-meta { font-size: 0.8rem; color: #777; font-family: 'JetBrains Mono'; }
.st-rating { font-size: 0.85rem; color: var(--accent); font-weight: 800; }


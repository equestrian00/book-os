/* ================================================== */
/* --- VINTAGE DARK ACADEMIA THEME --- */
/* ================================================== */

/* 1. IMPORT VINTAGE FONTS */
@import url('https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=Playfair+Display:wght@700;900&display=swap');

/* 2. ROOT VARIABLES (DARK PAPER PALETTE) */
:root {
    /* Backgrounds: Deep, Warm, Aged */
    --bg-root: #1a1816; 
    --paper-texture: url("https://www.transparenttextures.com/patterns/black-felt.png"); /* Subtle grain */
    
    /* Panels: Dark Cardstock / Leather */
    --glass-panel: #262320; 
    --glass-border: #3e3a35;
    --glass-highlight: rgba(255, 255, 255, 0.03);
    
    /* Text: Antique White & Muted Gold */
    --text-main: #dcd6ce; /* Off-white for reading */
    --text-muted: #8c867a; /* Muted tan */
    
    /* Accents: Vintage Gold & Dried Ink */
    --accent: #c5a059; /* Antique Gold */
    --accent-glow: rgba(197, 160, 89, 0.15);
    --antique-gold: #c5a059;
    
    --gold: #d4ac0d; 
    --danger: #a94442; /* Muted Red */
    --success: #557c55; /* Muted Green */
}

/* 3. GLOBAL BACKGROUND */
.eth-ui-wrapper {
    background-color: var(--bg-root);
    background-image: var(--paper-texture);
    color: var(--text-main);
}

/* 4. NAVIGATION BAR (DARK WOOD / LEATHER) */
.eth-nav-island.floating-hud {
    background: #23201d;
    border: 1px solid #3e3a35;
    box-shadow: 
        0 15px 40px -10px rgba(0,0,0,0.6),
        inset 0 1px 0 rgba(255,255,255,0.05);
    border-radius: 12px;
}

/* Search Bar */
.search-and-filter-group {
    background: #181614;
    border: 1px solid #33302b;
    box-shadow: inset 0 2px 10px rgba(0,0,0,0.3);
}
.modern-search-input input { 
    color: var(--text-accent); 
    font-family: 'Crimson Text', serif; 
    font-size: 1.1rem; 
    letter-spacing: 0.5px;
}
.modern-search-input input::placeholder { color: #555; font-style: italic; }

/* Buttons */
.eth-seg-btn { color: #777; font-family: 'JetBrains Mono'; font-weight: 600; }
.eth-seg-btn:hover { color: var(--text-main); }
.eth-seg-btn.active {
    background: #33302b;
    color: var(--accent);
    border: 1px solid #444;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);

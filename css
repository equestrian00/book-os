}
.lc-grid-row.filled { color: #2c2c2c; font-family: 'Courier New', monospace; font-weight: 600; }

.lc-col-sign { 
    display: flex; align-items: center; justify-content: center; 
    border-right: 2px solid #2c2c2c; /* The vertical red line */

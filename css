}
.lc-field { display: flex; flex-direction: column; gap: 4px; }
.lc-field.author { flex: 1; }
.lc-field.added { width: 100px; align-items: center; }

.lc-label {
    font-family: 'JetBrains Mono'; font-size: 0.6rem; font-weight: 700;

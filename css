/* --- ANALYTICS UPDATE --- */

/* 5 Column Grid for Hero Stats */
.stats-hero-grid.five-col {
    grid-template-columns: repeat(5, 1fr);
}

/* New Distribution Row */
.stats-distribution-grid {
    display: grid; 
    grid-template-columns: 1.5fr 1fr; /* Pie is wider */
    gap: 10px; 
    margin-bottom: 25px;
}
.header-count {
    opacity: 0.5; font-size: 0.7em; margin-left: 5px;
}

/* Pie Chart Styling */
.pie-container {
    display: flex; align-items: center; gap: 40px; justify-content: center; padding: 10px;
}
.pie-chart {
    width: 140px; height: 140px; border-radius: 50%;
    box-shadow: 0 0 20px rgba(0,0,0,0.5);
    flex-shrink: 0;
}
.pie-legend {
    display: flex; flex-direction: column; gap: 8px;
}
.pl-item {
    display: flex; align-items: center; gap: 10px; font-size: 0.8rem; color: #ccc;
}
.pl-item .dot {
    width: 10px; height: 10px; border-radius: 50%;
}
.pl-item .muted { opacity: 0.4; font-size: 0.7rem; font-family: 'JetBrains Mono'; margin-right: auto; margin-top: 2px; }
.pl-item b { color: white; font-family: 'JetBrains Mono'; }

/* Fiction vs Nonfiction Bar */
.type-bar-container {
    padding: 20px 10px; display: flex; flex-direction: column; gap: 15px; justify-content: center; height: 100%;
}
.type-bar {
    width: 100%; height: 24px; background: #333; border-radius: 12px; overflow: hidden; position: relative;
    box-shadow: inset 0 2px 5px rgba(0,0,0,0.5);
}
.tb-fill.fiction {
    height: 100%; background: var(--accent); 
    box-shadow: 0 0 15px var(--accent-glow);
    transition: width 1s ease;
}
.type-legend {
    display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 700; color: #888; letter-spacing: 1px;
}
.type-legend b { color: white; margin-left: 6px; font-family: 'JetBrains Mono'; }

/* Delete Button for Shelves (User Lists) */
.stack-delete-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
    z-index: 25; /* Above the badge and overlay */
    opacity: 0;
    transition: all 0.2s ease;
}

/* Show it when hovering over the card */
.stack-card:hover .stack-delete-btn {
    opacity: 1;
}

/* Hover state for the button itself */
.stack-delete-btn:hover {
    background: var(--danger);
    border-color: var(--danger);
    transform: scale(1.1);
}

.stack-delete-btn svg {
    width: 14px;
    height: 14px;
}

